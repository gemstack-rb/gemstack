#!/usr/bin/env bash
# End-to-end check of the generators: builds a real app from this checkout,
# generates resources that cover the edge cases, then runs the generated Ruby
# tests, the TypeScript typecheck and a Next.js production build.
#
#   script/e2e                                                         # SQLite (no server needed)
#   GEMSTACK_E2E_DATABASE=postgresql GEMSTACK_E2E_DATABASE_URL=postgres://user:pass@localhost:5432 script/e2e
#   GEMSTACK_E2E_DATABASE=mysql2 GEMSTACK_E2E_DATABASE_URL=mysql2://root:pass@127.0.0.1:3306 script/e2e
#
# For PostgreSQL/MySQL the URL is a server (no database name); databases
# e2e_app_* are created and dropped. Needs Node.js and network access for npm
# on the first run.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATABASE="${GEMSTACK_E2E_DATABASE:-sqlite3}"
if [ "$DATABASE" != "sqlite3" ]; then
  SERVER="${GEMSTACK_E2E_DATABASE_URL:?set GEMSTACK_E2E_DATABASE_URL to a $DATABASE server URL (no database name)}"
fi
WORK="$(mktemp -d)"
APP="$WORK/e2e_app"
trap 'rm -rf "$WORK"' EXIT

step() { printf "\n\033[1m== %s\033[0m\n" "$*"; }

step "gemstack new --database=$DATABASE"
"$ROOT/bin/gemstack" new "$APP" --skip-git --database="$DATABASE" > "$WORK/new.log" 2>&1 || { cat "$WORK/new.log"; exit 1; }
cd "$APP"
git init --quiet
grep -q "adapter: $DATABASE" config/database.yml || { echo "config/database.yml doesn't use $DATABASE"; exit 1; }
if [ -n "${SERVER:-}" ]; then
  printf "DATABASE_URL=%s/e2e_app_development\nTEST_DATABASE_URL=%s/e2e_app_test\n" "$SERVER" "$SERVER" > .env
fi
bin/gemstack db:drop > /dev/null 2>&1 || true
bin/gemstack db:create

step "a brand-new app typechecks (empty contract)"
(cd frontend && npx tsc --noEmit)

step "generate resources covering the edge cases"
bin/gemstack g resource Category name:string:unique
bin/gemstack g resource Product name:string price:decimal description:text:optional sku:string:unique \
  category:references active:boolean stock:integer weight:float:optional released_on:date:optional \
  published_at:datetime:optional token:uuid:optional meta:json:optional
bin/gemstack g resource Note body:text                              # single field
bin/gemstack g resource Page title:string slug:string:unique        # collides with GemStack's Page names
bin/gemstack g resource Report title:string --actions=index,show    # read-only
bin/gemstack g resource AuditLog message:text --api-only            # no frontend
bin/gemstack g job SendDigest mailers
if bin/gemstack g job Digest > /dev/null 2>&1; then echo "expected 'Digest' to be refused"; exit 1; fi

step "add realtime"
bin/gemstack add realtime
cat > config/channels.rb <<'RUBY'
GemStack.channels do
  identify { |_request| { id: "e2e-client", name: "E2E" } }
  channel "products"
  channel "e2e", presence: true
  receive "e2e" do |message|
    GemStack.broadcast("e2e", "echoed", message.data)
    message.data
  end
  channel "orders:*" do |id, request|
    request.get_header("HTTP_AUTHORIZATION") == "Bearer #{id}"
  end
end
RUBY
cat > test/realtime_test.rb <<'RUBY'
require_relative "test_helper"

class RealtimeTest < GemStack::TestCase
  def test_broadcast_uses_the_serializer
    product = Product.create(GemStack::DB::Testing.sample_attributes(Product))
    GemStack.broadcast("products", "product.created", product)

    assert_broadcast "products", "product.created", data: ProductSerializer.serialize(product)
  end

  def test_channel_rules
    request = Rack::Request.new(Rack::MockRequest.env_for("/", "HTTP_AUTHORIZATION" => "Bearer 7"))

    assert GemStack.channels.authorized?("orders:7", request)
    refute GemStack.channels.authorized?("orders:8", request)
    refute GemStack.channels.authorized?("anything-else", request)
  end
end
RUBY
cat > frontend/components/LiveProducts.tsx <<'TSX'
"use client";
import { useState } from "react";
import type { Product } from "@/lib/api/generated";
import { realtime, usePresence, useRealtime, useRealtimeStatus } from "@/lib/gemstack/realtime";

export function LiveProducts() {
  const [names, setNames] = useState<string[]>([]);
  useRealtime<Product>("products", (event) => setNames((current) => [...current, event.data.name]));
  const here = usePresence<{ name: string }>("e2e");
  const status = useRealtimeStatus();
  const say = () => realtime.send<{ text: string }>("e2e", "echo", { text: "hi" }).then((reply) => reply.text);
  return (
    <div data-status={status}>
      <ul>{names.map((name) => <li key={name}>{name}</li>)}</ul>
      <p>{here.map((person) => person.meta?.name).join(", ")}</p>
      <button onClick={say}>say</button>
    </div>
  );
}
TSX

step "add auth + storage, generate a policy"
bin/gemstack add auth
bin/gemstack add storage
bin/gemstack g policy Product
if bin/gemstack add auth > /dev/null 2>&1; then :; else echo "expected 'add auth' to be idempotent"; exit 1; fi
test "$(ls db/migrations | grep -c create_auth_tables)" = 1

step "migrate + Ruby tests"
bin/gemstack db:migrate
bin/gemstack test

step "realtime client over WebSocket (subscribe, send, presence, reconnect + replay)"
PORT_RT=$(ruby -rsocket -e 's = TCPServer.new("127.0.0.1", 0); print s.addr[1]; s.close')
bin/gemstack server -p "$PORT_RT" > "$WORK/realtime-server.log" 2>&1 &
SERVER_PID=$!
for _ in $(seq 60); do curl -fsS "http://127.0.0.1:$PORT_RT/api/health" > /dev/null 2>&1 && break; sleep 0.5; done
(cd frontend && npx tsc --outDir "$WORK/rt" --module commonjs --target es2022 --skipLibCheck --esModuleInterop \
  lib/gemstack/realtime.ts lib/gemstack/client.ts)
cat > "$WORK/realtime-client.js" <<'JS'
const port = process.argv[2];
global.window = { location: { protocol: "http:", host: `127.0.0.1:${port}` }, addEventListener() {} };
const { realtime } = require(`${process.argv[3]}/realtime.js`);
const until = (check, what) => new Promise((resolve, reject) => {
  const started = Date.now();
  const poll = () => (check() ? resolve() : Date.now() - started > 8000 ? reject(new Error(`timeout: ${what}`)) : setTimeout(poll, 20));
  poll();
});
(async () => {
  const events = [];
  realtime.subscribe("e2e", (event) => events.push(event));
  await until(() => realtime.status === "open", "connected");
  const reply = await realtime.send("e2e", "echo", { text: "hi" });
  if (reply.text !== "hi") throw new Error(`reply ${JSON.stringify(reply)}`);
  await until(() => events.some((e) => e.event === "echoed" && e.data.text === "hi"), "broadcast from receive");
  await until(() => realtime.presenceOf("e2e").some((p) => p.id === "e2e-client"), "presence");

  // Drop the connection and broadcast while it's down: the client reconnects,
  // resubscribes with its last event id and gets the missed event replayed.
  const other = new WebSocket(`ws://127.0.0.1:${port}/api/realtime`);
  await new Promise((resolve) => other.addEventListener("message", (m) => JSON.parse(m.data).type === "welcome" && resolve()));
  other.send(JSON.stringify({ type: "subscribe", channel: "e2e" }));
  realtime.socket.close();
  await until(() => realtime.status === "reconnecting", "noticed the drop");
  other.send(JSON.stringify({ type: "message", channel: "e2e", event: "echo", data: { text: "while away" } }));
  await until(() => events.some((e) => e.data && e.data.text === "while away"), "replayed after reconnect");
  if (realtime.status !== "open") throw new Error(`status ${realtime.status}`);
  console.log("realtime client OK");
  process.exit(0);
})().catch((error) => { console.error(error); process.exit(1); });
JS
NODE_PATH="$PWD/frontend/node_modules" node "$WORK/realtime-client.js" "$PORT_RT" "$WORK/rt" || { tail -30 "$WORK/realtime-server.log"; kill $SERVER_PID; exit 1; }
kill $SERVER_PID; wait $SERVER_PID 2> /dev/null || true

step "destroy preserves data, migrations and custom files"
bin/gemstack g resource Post title:string body:text:optional --skip-contract
bin/gemstack db:migrate
bin/gemstack contract

ruby -r ./config/app -e 'GemStack.boot!; Post.create(title: "Preserved data")'
printf 'Custom file: keep me\n' > frontend/app/posts/notes.txt
cp .gemstack/generators.json "$WORK/manifest.json"
bin/gemstack d resource Post --dry-run
cmp .gemstack/generators.json "$WORK/manifest.json"
test -f app/models/post.rb
test -f frontend/app/posts/page.tsx

printf '\n# User customization\n' >> app/models/post.rb
if bin/gemstack d resource Post --yes > "$WORK/refusal.log" 2>&1; then
  echo "Expected modified-file protection to refuse removal"
  exit 1
fi
grep -q 'Modified file' "$WORK/refusal.log"
test -f app/controllers/posts_controller.rb

bin/gemstack d resource Post --yes --force
test ! -f app/models/post.rb
test ! -f frontend/app/posts/page.tsx
test ! -f frontend/lib/api/generated/posts.ts
test -f frontend/app/posts/notes.txt
test -f frontend/lib/format.ts
test -f frontend/lib/api/generated/categories.ts
ruby -r ./config/app -e '
  GemStack.boot!
  abort "Lost database data" unless GemStack.db[:posts].get(:title) == "Preserved data"
  abort "Lost migration history" unless Dir["db/migrations/*_create_posts.rb"].one?
  abort "Stale Post contract" if JSON.parse(File.read("openapi.json")).fetch("paths").keys.any? { |p| p.start_with?("/api/posts") }
'
bin/gemstack d resource Post --yes

step "regenerate an applied resource and migrate an added column"
bin/gemstack g resource Post title:string body:text:optional price:decimal:optional --skip-contract > "$WORK/regenerate.log"
cat "$WORK/regenerate.log"
grep -q 'gemstack g migration AddPriceToPosts price:decimal:optional' "$WORK/regenerate.log"
bin/gemstack g migration AddPriceToPosts price:decimal:optional
bin/gemstack db:migrate
ruby -r ./config/app -e '
  GemStack.boot!
  abort "Duplicate create migration" unless Dir["db/migrations/*_create_posts.rb"].one?
  abort "Lost data on regeneration" unless Post.first.title == "Preserved data"
  abort "Missing regenerated field" unless GemStack.db.schema(:posts).to_h.key?(:price)
'
bin/gemstack d resource Post --yes

bin/gemstack g model Draft title:string
bin/gemstack d model Draft --yes --skip-contract
test ! -f app/models/draft.rb
test -z "$(find db/migrations -name '*_create_drafts.rb' -print)"
bin/gemstack g model Draft title:string
bin/gemstack db:migrate
bin/gemstack d model Draft --yes --skip-contract
bin/gemstack g controller Exports index show
bin/gemstack d controller Exports --yes
test ! -f app/controllers/exports_controller.rb

step "destroy in development preserves a committed migration already applied in test"
bin/gemstack g model SharedDraft title:string
git add db/migrations/*_create_shared_drafts.rb
git -c user.name="GemStack Test" -c user.email="test@gemstack.local" \
  commit --quiet --no-gpg-sign -m "Add shared draft migration"
bin/gemstack db:migrate -e test
bin/gemstack d model SharedDraft --yes --skip-contract
test ! -f app/models/shared_draft.rb
test -n "$(find db/migrations -name '*_create_shared_drafts.rb' -print)"
bin/gemstack db:migrate -e test

step "destroy a job, a policy and a migration"
bin/gemstack g job WeeklyReport
bin/gemstack d job WeeklyReport --yes
test ! -f app/jobs/weekly_report.rb && test ! -f test/jobs/weekly_report_test.rb
test -f app/jobs/send_digest.rb # other jobs stay
test -n "$(find db/migrations -name '*_create_gemstack_jobs.rb' -print)" # the shared jobs table stays
bin/gemstack g policy Note
bin/gemstack d policy Note --yes
test ! -f app/policies/note_policy.rb && test ! -f test/policies/note_policy_test.rb
bin/gemstack g migration AddSummaryToProducts summary:text:optional
bin/gemstack d migration AddSummaryToProducts --yes
test -z "$(find db/migrations -name '*_add_summary_to_products.rb' -print)"

bin/gemstack db:migrate
bin/gemstack test

step "template update on a brand-new app"
test "$(cat .gemstack/version)" = "$(ruby -I"$ROOT/gems/gemstack/lib" -e 'require "gemstack/version"; print GemStack::VERSION')"
bin/gemstack update --templates --dry-run | tee "$WORK/templates.log"
grep -q "nothing to update" "$WORK/templates.log"

step "doctor + deploy files"
bin/gemstack doctor
bin/gemstack g deploy
bundle install --quiet # the kamal gem the generator added
# Kamal loads and validates config/deploy.yml (roles, proxy, accessories, secrets).
bundle exec ruby -e '
  require "kamal"
  config = Kamal::Configuration.create_from(config_file: Pathname.new("config/deploy.yml"), version: "e2e")
  roles = config.roles.map(&:name).sort
  abort "unexpected Kamal roles: #{roles}" unless roles == %w[api jobs web]
  puts "config/deploy.yml is valid (roles: #{roles.join(", ")})"
'
bin/gemstack d deploy --yes
test ! -f config/deploy.yml && test ! -f Dockerfile && test ! -f .kamal/secrets && test ! -f bin/docker-entrypoint
if grep -q '^gem "kamal"' Gemfile; then echo "destroy deploy left the kamal gem in the Gemfile"; exit 1; fi
bundle install --quiet

step "TypeScript"
(cd frontend && npx tsc --noEmit)

step "Next.js production build"
(cd frontend && npx next build > "$WORK/build.log" 2>&1) || { tail -40 "$WORK/build.log"; exit 1; }

step "cleanup"
bin/gemstack db:drop > /dev/null
GEMSTACK_ENV=test bin/gemstack db:drop > /dev/null
echo "e2e passed"
