#!/usr/bin/env ruby
# frozen_string_literal: true

# Fails when a tracked file looks like it could hold secrets or data (.env,
# keys, credentials, dumps, logs). Everything in this repository is public.
#
#   script/check-secret-files
#
# Run by CI on every push and pull request, and by the release workflow and
# script/release before publishing.
require "open3"

module GemStackSecretFiles
  ROOT = File.expand_path("..", __dir__)
  PATTERN = Regexp.union(
    %r{(^|/)\.env($|\.[^e])}, /\.(pem|key|sql|csv|log)$/, %r{(^|/)(secrets?|credentials?)(\.[a-z]+)*$}, /_secret$/
  ).then { |union| Regexp.new(union.source, Regexp::IGNORECASE) }
  # Templates that are named like secret files on purpose. Each is allowed only
  # while every KEY=VALUE line references a value ($NAME, $(command)) instead of
  # containing one.
  REFERENCE_TEMPLATES = %w[gems/gemstack/templates/deploy/dot_kamal/secrets.tt].freeze

  module_function

  def tracked
    out, status = Open3.capture2("git", "ls-files", chdir: ROOT)
    abort "git ls-files failed" unless status.success?
    out.lines(chomp: true)
  end

  # KEY=VALUE lines whose value is written in place (no $ reference).
  def literal_values(content)
    content.lines.filter_map do |line|
      next if line.strip.empty? || line.lstrip.start_with?("#", "<%")

      name, value = line.strip.split("=", 2)
      name if value && !value.strip.empty? && !value.include?("$")
    end
  end

  # [path, reason] for every file that must not be published.
  def problems(files, read: ->(path) { File.read(File.join(ROOT, path)) })
    files.grep(PATTERN).filter_map do |path|
      next [path, "looks like a secret or data file"] unless REFERENCE_TEMPLATES.include?(path)

      literal = literal_values(read.call(path))
      [path, "contains values instead of references: #{literal.join(", ")}"] if literal.any?
    end
  end
end

if $PROGRAM_NAME == __FILE__
  problems = GemStackSecretFiles.problems(GemStackSecretFiles.tracked)
  if problems.empty?
    puts "✓ no tracked file looks like a secret or data file"
  else
    problems.each { |path, reason| puts "✗ #{path}: #{reason}" }
    puts "\nRemove these from git (and rotate anything they contained) before publishing; ask the tech team " \
         "to review if real data or secrets were ever committed."
    exit 1
  end
end
