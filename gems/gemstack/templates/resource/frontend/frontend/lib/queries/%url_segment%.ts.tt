"use client";

// TanStack Query hooks for <%= spec.human_plural.downcase %>, built on the generated API client.
import { keepPreviousData, useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { <%= spec.client_name %> } from "@/lib/api/generated";
import type { <%= [class_name, (spec.action?(:create) ? "#{class_name}Input" : nil), (spec.action?(:update) ? "#{class_name}UpdateInput" : nil)].compact.join(", ") %> } from "@/lib/api/generated";

export const <%= spec.variable %>Keys = {
  all: ["<%= spec.plural %>"] as const,
  detail: (id: string | number) => ["<%= spec.plural %>", String(id)] as const,
};
<% if spec.action?(:index) -%>

// perPage: records per page; omit it to use the API's default (config.http.pagination.per_page).
export function use<%= spec.plural_class %>(page = 1, perPage?: number) {
  return useQuery({
    queryKey: [...<%= spec.variable %>Keys.all, "page", page, perPage],
    queryFn: () => <%= spec.client_name %>.list({ page, per_page: perPage }),
    placeholderData: keepPreviousData, // keep the current page visible while the next one loads
  });
}
<% end -%>
<% if spec.action?(:show) -%>

export function use<%= class_name %>(id: string | number) {
  return useQuery({ queryKey: <%= spec.variable %>Keys.detail(id), queryFn: () => <%= spec.client_name %>.get(id) });
}
<% end -%>
<% if spec.action?(:create) -%>

export function useCreate<%= class_name %>() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (data: <%= class_name %>Input) => <%= spec.client_name %>.create(data),
    onSuccess: (<%= spec.variable %>: <%= class_name %>) => {
      queryClient.setQueryData(<%= spec.variable %>Keys.detail(<%= spec.variable %>.id), <%= spec.variable %>);
      return queryClient.invalidateQueries({ queryKey: <%= spec.variable %>Keys.all });
    },
  });
}
<% end -%>
<% if spec.action?(:update) -%>

export function useUpdate<%= class_name %>(id: string | number) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (data: <%= class_name %>UpdateInput) => <%= spec.client_name %>.update(id, data),
    onSuccess: (<%= spec.variable %>: <%= class_name %>) => {
      queryClient.setQueryData(<%= spec.variable %>Keys.detail(id), <%= spec.variable %>);
      return queryClient.invalidateQueries({ queryKey: <%= spec.variable %>Keys.all });
    },
  });
}
<% end -%>
<% if spec.action?(:destroy) -%>

export function useDelete<%= class_name %>() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (id: string | number) => <%= spec.client_name %>.delete(id),
    onSuccess: () => queryClient.invalidateQueries({ queryKey: <%= spec.variable %>Keys.all }),
  });
}
<% end -%>
