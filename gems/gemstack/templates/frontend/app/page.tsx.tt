"use client";

import { useQuery } from "@tanstack/react-query";
import { useState } from "react";
import { api, API_PATH } from "@/lib/gemstack/client";
import styles from "./page.module.css";

// The GemStack welcome page: shows that Next.js renders and that the browser
// reaches the Ruby API through the same origin. Replace it with your app —
// this file and app/page.module.css are yours to delete.

const DOCS = "https://github.com/gemstack-rb/gemstack/tree/main/docs";

export default function Welcome() {
  const health = useQuery({
    queryKey: ["gemstack", "health"],
    queryFn: async () => {
      const started = performance.now();
      const body = await api.get<{ status: string }>("/health");
      return { ...body, ms: Math.round(performance.now() - started) };
    },
    retry: 1,
  });
  const apiState = health.isPending ? "pending" : health.isError ? "error" : "ok";

  return (
    <div className={styles.shell}>
      <main className={styles.main}>
        <header className={styles.hero}>
          <GemLogo className={styles.logo} />
          <p className={styles.eyebrow}>GemStack</p>
          <h1 className={styles.title}>
            Yay! You&apos;re on <span className={styles.accent}>GemStack</span>.
          </h1>
          <p className={styles.lead}>
            <strong><%= module_name %></strong> is running: a Next.js frontend and a Ruby API, served from one origin.
          </p>

          <div className={styles.checks} role="status" aria-live="polite">
            <span className={`${styles.check} ${styles.ok}`}>
              <span className={styles.dot} aria-hidden="true" /> Next.js rendering
            </span>
            <span className={`${styles.check} ${styles[apiState]}`}>
              <span className={styles.dot} aria-hidden="true" />
              {apiState === "pending" && "Connecting to the Ruby API…"}
              {apiState === "ok" && (
                <>
                  Ruby API connected · <code>GET {API_PATH}/health</code> in {health.data?.ms} ms
                </>
              )}
              {apiState === "error" && <>Ruby API unreachable: {health.error?.message}</>}
            </span>
          </div>
        </header>

        <section className={styles.grid} aria-label="Next steps">
          <Card
            step="1"
            title="Generate a resource"
            text="Migration, model, API, typed TypeScript client and Next.js pages — in one command."
            command="gemstack g resource Product name:string"
          />
          <Card
            step="2"
            title="Explore your API"
            text="Every endpoint with its types, and a form to try requests from the browser."
            href={`${API_PATH}/docs`}
            linkLabel={`Open ${API_PATH}/docs`}
          />
          <Card
            step="3"
            title="Check your setup"
            text="Ruby, Node.js, the database, migrations and the TypeScript contract — with the fix for anything off."
            command="gemstack doctor"
          />
          <Card
            step="4"
            title="Read the guides"
            text="Models, controllers, jobs, realtime, authentication, storage and deployment."
            href={DOCS}
            linkLabel="Open the guides"
            external
          />
        </section>

        <p className={styles.edit}>
          Edit <code>frontend/app/page.tsx</code> to replace this page · API code lives in <code>app/</code>
        </p>
      </main>

      <footer className={styles.footer}>
        <span>
          GemStack <%= version %> · Ruby <%= ruby_version %> · Next.js
        </span>
        <span>
          Open source by{" "}
          <a href="https://www.adwaretech.com" target="_blank" rel="noreferrer">
            Adware Technologies
          </a>
        </span>
      </footer>
    </div>
  );
}

function Card(props: {
  step: string;
  title: string;
  text: string;
  command?: string;
  href?: string;
  linkLabel?: string;
  external?: boolean;
}) {
  return (
    <article className={styles.card}>
      <span className={styles.step} aria-hidden="true">
        {props.step}
      </span>
      <h2 className={styles.cardTitle}>{props.title}</h2>
      <p className={styles.cardText}>{props.text}</p>
      {props.command && <Command text={props.command} />}
      {props.href && (
        <a
          className={styles.link}
          href={props.href}
          {...(props.external ? { target: "_blank", rel: "noreferrer" } : {})}
        >
          {props.linkLabel} <span aria-hidden="true">→</span>
        </a>
      )}
    </article>
  );
}

function Command({ text }: { text: string }) {
  const [copied, setCopied] = useState(false);
  async function copy() {
    try {
      await navigator.clipboard.writeText(text);
      setCopied(true);
      setTimeout(() => setCopied(false), 1500);
    } catch {
      // Clipboard unavailable (e.g. not a secure context): the command stays selectable.
    }
  }
  return (
    <div className={styles.command}>
      <code>
        <span className={styles.prompt} aria-hidden="true">
          $
        </span>{" "}
        {text}
      </code>
      <button type="button" className={styles.copy} onClick={copy} aria-label={`Copy: ${text}`}>
        {copied ? "Copied" : "Copy"}
      </button>
    </div>
  );
}

function GemLogo({ className }: { className?: string }) {
  return (
    <svg className={className} viewBox="0 0 64 64" role="img" aria-label="GemStack">
      <path d="M8 20 22 6l4 14z" fill="#e11d48" />
      <path d="M22 6h20l-4 14H26z" fill="#fb5a78" />
      <path d="M42 6l14 14H38z" fill="#be123c" />
      <path d="M8 20h18l6 20z" fill="#9f1239" />
      <path d="M26 20h12l-6 20z" fill="#e11d48" />
      <path d="M38 20h18L32 40z" fill="#881337" />
      <rect className={styles.stackTop} x="10" y="44" width="44" height="7" rx="3" />
      <rect className={styles.stackBottom} x="5" y="55" width="54" height="7" rx="3" />
    </svg>
  );
}
