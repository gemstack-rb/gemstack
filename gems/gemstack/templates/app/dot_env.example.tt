# Copy to .env for local development overrides. Never commit real secrets.
# Variables already set in your shell always take precedence.

# PORT=3000                   # public development port (gemstack dev)
# GEMSTACK_LOG_LEVEL=debug

<% if database? -%>
# Database: config/database.yml. A URL here overrides it (hosting platforms set DATABASE_URL).
<% if database_adapter == "sqlite3" -%>
# DATABASE_URL=sqlite3:db/development.sqlite3
<% elsif database_adapter == "postgresql" -%>
# DATABASE_URL=postgres://user:password@localhost:5432/<%= database_name %>_development
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/<%= database_name %>_test
<% else -%>
# DATABASE_PASSWORD=
# DATABASE_URL=<%= database_adapter %>://root:password@127.0.0.1:3306/<%= database_name %>_development
# TEST_DATABASE_URL=<%= database_adapter %>://root:password@127.0.0.1:3306/<%= database_name %>_test
<% end -%>
<% end -%>
