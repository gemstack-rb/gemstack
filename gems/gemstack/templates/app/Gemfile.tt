# frozen_string_literal: true

source "https://rubygems.org"

<% if gemstack_path -%>
# GemStack from a local checkout.
path "<%= gemstack_path %>" do
  gem "gemstack"
end
<% else -%>
gem "gemstack", "~> <%= version %>" # the framework: config/app.rb chooses the modules it loads
<% end -%>
gem "puma", ">= 6.4"
<% if database? -%>
gem "<%= driver_gem %>", "<%= driver_version %>" # the <%= database_adapter %> driver (config/database.yml)
<% end -%>

# Any gem works here as usual, e.g.:
# gem "brotli"         # Brotli compression (gzip is used without it)
# gem "redis-client"   # shared cache: config.cache.store = :redis
# gem "stripe"

group :development, :test do
  gem "irb" # `gemstack console` (a bundled gem, not a default one, in newer Rubies)
  gem "minitest", "~> 5.25"
  gem "rack-test", "~> 2.2"
end
