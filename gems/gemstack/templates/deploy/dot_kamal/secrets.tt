# Secrets for Kamal (config/deploy.yml), resolved on your machine at deploy time.
#
# This file is committed to git: only ever write REFERENCES here — environment
# variables ($NAME) or password-manager commands ($(kamal secrets fetch ...)) —
# never a secret's value. `gemstack doctor` flags values written in place.
#
# bin/deploy (gemstack deploy) loads the root .env.production.local, .env.production
# and .env (git-ignored) before Kamal reads this file: put the production values there.

# Docker Hub: an access token. GitHub's registry (ghcr.io): a token with write:packages,
# e.g. KAMAL_REGISTRY_PASSWORD=$(gh auth token) after `gh auth refresh -s write:packages`.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
<% if frontend? -%>
# The frontend's NEXT_PUBLIC_* settings from the root .env files (production first),
# compiled into the JavaScript at build time — public by design, nothing else is read.
GEMSTACK_PUBLIC_ENV=$(grep -hsE '^(export )?NEXT_PUBLIC_' .env.production.local .env.production .env)
<% end -%>
SECRET_KEY_BASE=$SECRET_KEY_BASE
<% if postgresql? -%>
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgres://app:$POSTGRES_PASSWORD@<%= service %>-db:5432/<%= database_name %>
<% elsif mysql? -%>
MYSQL_PASSWORD=$MYSQL_PASSWORD
DATABASE_URL=<%= database_adapter %>://app:$MYSQL_PASSWORD@<%= service %>-db:3306/<%= database_name %>
<% end -%>
<% if mail? -%>
SMTP_URL=$SMTP_URL
<% end -%>
