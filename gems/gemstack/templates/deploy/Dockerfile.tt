# syntax=docker/dockerfile:1
# Production image for <%= app_name %> (gemstack generate deploy — docs/deployment.md).
#
# One image runs every process; config/deploy.yml (Kamal) gives each role its command:
<% if frontend? -%>
#   web   node -r … frontend/server.js         Next.js (standalone server)
<% end -%>
#   api   bundle exec puma -C config/puma.rb   Ruby API (bin/docker-entrypoint migrates first)
<% if jobs? -%>
#   jobs  bundle exec gemstack jobs            background jobs
<% end -%>
#
#   docker build -t <%= service %> .
#
# Configuration comes from the environment at runtime (SECRET_KEY_BASE,
# DATABASE_URL, …); nothing secret is baked into the image. The frontend's
# NEXT_PUBLIC_* values, public by design, are compiled in at build time.

ARG RUBY_VERSION=<%= ruby_version %>
<% if frontend? -%>
ARG NODE_VERSION=<%= node_version %>
<% end -%>

FROM ruby:${RUBY_VERSION}-slim AS base
WORKDIR /app
ENV GEMSTACK_ENV=production BUNDLE_DEPLOYMENT=1 BUNDLE_WITHOUT="development:test" BUNDLE_PATH=/usr/local/bundle

# ── Ruby gems and application code ──────────────────────────────────────────
FROM base AS gems
RUN apt-get update -qq && apt-get install --no-install-recommends -y <%= build_packages %> \
    && rm -rf /var/lib/apt/lists/*
COPY Gemfile Gemfile.lock ./
COPY vendor/ ./vendor/
RUN bundle install --jobs 4 && rm -rf /usr/local/bundle/cache "${BUNDLE_PATH}"/ruby/*/cache
COPY . .
RUN rm -rf frontend tmp/* log/* .env* .kamal
<% if frontend? -%>

# ── Next.js (standalone build: the server and only the modules it needs) ─────
FROM node:${NODE_VERSION}-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1 GEMSTACK_NEXT_OUTPUT=standalone
# NEXT_PUBLIC_* values are compiled into the JavaScript here. They come from the
# root .env as a build secret (.kamal/secrets: GEMSTACK_PUBLIC_ENV), mounted where
# next.config.ts reads the root .env, for this step only: never stored in the image.
RUN --mount=type=secret,id=GEMSTACK_PUBLIC_ENV,target=/.env,required=false npm run build \
    && mkdir -p public && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/
<% end -%>

# ── Runtime ─────────────────────────────────────────────────────────────────
FROM base
RUN apt-get update -qq && apt-get install --no-install-recommends -y <%= runtime_packages %> \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 app && useradd --system --uid 1000 --gid app --create-home app<% if sqlite? %> \
    && mkdir -p /data && chown app:app /data<% end %>
COPY --from=gems /usr/local/bundle /usr/local/bundle
COPY --from=gems --chown=app:app /app /app
<% if frontend? -%>
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend --chown=app:app /frontend/.next/standalone /app/frontend
COPY --from=frontend --chown=app:app /frontend/lib/gemstack/root-env.cjs /app/frontend/lib/gemstack/root-env.cjs
<% end -%>
ENV GEMSTACK_API_HOST=0.0.0.0 GEMSTACK_API_PORT=4000<% if frontend? %> NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000<% end %>
USER app
EXPOSE <%= frontend? ? "3000 4000" : "4000" %>
ENTRYPOINT ["/app/bin/docker-entrypoint"]
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
