# Kamal deploy configuration for <%= app_name %> (gemstack generate deploy — docs/deployment.md).
#
#   bin/deploy setup    # first deploy: Docker, kamal-proxy (HTTPS) and accessories on the server
#   bin/deploy          # every deploy after that (the last commit), with zero downtime
#   bin/deploy logs     # any Kamal command or alias below: console, migrate, rollback VERSION…
#
# bin/deploy (gemstack deploy) runs Kamal with the root .env.production and .env
# loaded. Replace the placeholders marked CHANGE. Secrets are read from
# .kamal/secrets, which only references those variables, never their values.

service: <%= service %>

# CHANGE: your registry user (Docker Hub here; see registry: below for others).
image: your-user/<%= service %>

servers:
<% if frontend? -%>
  web:
    hosts:
      - 192.168.0.1 # CHANGE: your server's IP or hostname
    cmd: node -r ./frontend/lib/gemstack/root-env.cjs frontend/server.js
    # Not the primary role (see primary_role below), so the proxy is enabled explicitly.
    proxy: true
    env:
      clear:
        # Server Components call the API directly, through the alias below.
        GEMSTACK_API_URL: http://<%= service %>-api:4000
  api:
    hosts:
      - 192.168.0.1 # CHANGE
    cmd: bundle exec puma -C config/puma.rb
    options:
      network-alias: <%= service %>-api
    # The browser calls /api on the same origin: kamal-proxy sends it here.
    proxy:
      app_port: 4000
      path_prefix: /api
      strip_path_prefix: false
      # HTTPS comes from the web role's certificate (same domain, root path).
      ssl: false
      # Don't trust X-Forwarded-* headers sent by clients (IP-based rate limits).
      forward_headers: false
      healthcheck:
        path: /api/health
    env:
      clear:
        WEB_CONCURRENCY: 2
<% else -%>
  api:
    hosts:
      - 192.168.0.1 # CHANGE: your server's IP or hostname
    cmd: bundle exec puma -C config/puma.rb
    env:
      clear:
        WEB_CONCURRENCY: 2
<% end -%>
<% if jobs? -%>
  jobs:
    hosts:
      - 192.168.0.1 # CHANGE
    cmd: bundle exec gemstack jobs
<% end -%>

<% if frontend? -%>
# The API boots first: the web role's healthcheck (/) renders pages that call it,
# which fails on the first deploy if the web role boots before any API is running.
<% end -%>
primary_role: api

# HTTPS with a Let's Encrypt certificate: point the domain's DNS at the server first.
proxy:
  ssl: true
  host: app.example.com # CHANGE: your domain
  # Serving www and the bare domain: list both (each gets a certificate) and
  # redirect one to the other in frontend/next.config.ts (docs/deployment.md).
  # hosts:
  #   - www.example.com
  #   - example.com
<% if frontend? -%>
  app_port: 3000
  healthcheck:
    path: /
<% else -%>
  app_port: 4000
  healthcheck:
    path: /api/health
<% end -%>

registry:
  # server: ghcr.io # for GitHub's registry (password: see .kamal/secrets); Docker Hub is the default
  username: your-user # CHANGE
  password:
    - KAMAL_REGISTRY_PASSWORD

env:
  clear:
    GEMSTACK_ENV: production
    APP_URL: https://app.example.com # CHANGE: the public URL (email links)
<% if sqlite? -%>
    DATABASE_URL: sqlite3:/data/production.sqlite3
<% end -%>
<% if redis? -%>
    REDIS_URL: redis://<%= service %>-redis:6379/0
<% end -%>
<% if mail? -%>
    MAIL_FROM: app@example.com # CHANGE
<% end -%>
  secret:
    - SECRET_KEY_BASE
<% if database? && !sqlite? -%>
    - DATABASE_URL
<% end -%>
<% if mail? -%>
    - SMTP_URL
<% end -%>
<% if sqlite? -%>

# The SQLite file lives on this volume, shared by every role: keep them on one server.
# For production, PostgreSQL is recommended (docs/database.md): switch the app to it
# and `gemstack generate deploy --force` adds the database accessory.
volumes:
  - "<%= service %>_data:/data"
<% end -%>

# Kamal connects as root; set the user your server logs in with (e.g. ubuntu on AWS).
# ssh:
#   user: ubuntu

builder:
  arch: amd64
<% if frontend? -%>
  # The root .env's NEXT_PUBLIC_* lines, for `next build` (see .kamal/secrets).
  secrets:
    - GEMSTACK_PUBLIC_ENV
<% end -%>
<% if postgresql? || mysql? || redis? -%>

accessories:
<% if postgresql? -%>
  db:
    image: postgres:17
    host: 192.168.0.1 # CHANGE
    env:
      clear:
        POSTGRES_USER: app
        POSTGRES_DB: <%= database_name %>
      secret:
        - POSTGRES_PASSWORD
    directories:
      - data:/var/lib/postgresql/data
<% elsif mysql? -%>
  db:
    image: mysql:8.4
    host: 192.168.0.1 # CHANGE
    env:
      clear:
        MYSQL_USER: app
        MYSQL_DATABASE: <%= database_name %>
        MYSQL_RANDOM_ROOT_PASSWORD: "yes"
      secret:
        - MYSQL_PASSWORD
    directories:
      - data:/var/lib/mysql
<% end -%>
<% if redis? -%>
  redis:
    image: redis:7
    host: 192.168.0.1 # CHANGE
    cmd: redis-server --save "" --appendonly no
<% end -%>
<% end -%>

# bin/deploy console | logs | migrate | shell
aliases:
  console: app exec --interactive --reuse --roles=api "bundle exec gemstack console"
  logs: app logs --follow
<% if database? -%>
  migrate: app exec --roles=api "bundle exec gemstack db:migrate"
<% end -%>
  shell: app exec --interactive --reuse --roles=api "bash"
