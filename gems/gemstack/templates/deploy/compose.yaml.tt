# Runs <%= app_name %> in production mode on this machine, behind Caddy on https://localhost:
#
#   export SECRET_KEY_BASE=$(openssl rand -hex 64)<% if postgresql? %> POSTGRES_PASSWORD=$(openssl rand -hex 16)<% elsif mysql? %> MYSQL_PASSWORD=$(openssl rand -hex 16)<% end %>
#   docker compose up --build
#
# It's also a map of what a real deploy needs: one image per process type,
# migrations before the API starts, and a proxy sending /api to Ruby.
<% if sqlite? -%>
# SQLite: the database file lives on the `data` volume, shared by the API, the
# jobs worker and migrations — keep them on one host.
<% end -%>
name: <%= app_name.tr("_", "-") %>

x-api-env: &api-env
  GEMSTACK_ENV: production
  SECRET_KEY_BASE: ${SECRET_KEY_BASE:?set SECRET_KEY_BASE (openssl rand -hex 64)}
<% if database? -%>
  DATABASE_URL: <%= database_url %>
<% end -%>
<% if redis? -%>
  REDIS_URL: redis://redis:6379/0 # realtime fan-out between the API and the jobs worker
<% end -%>
  APP_URL: ${APP_URL:-https://localhost}
<% if mail? -%>
  SMTP_URL: ${SMTP_URL:-}   # e.g. smtp://user:pass@smtp.example.com:587 — emails retry until it is set
  MAIL_FROM: ${MAIL_FROM:-}
<% end -%>

services:
<% if postgresql? -%>
  db:
    image: postgres:17
    environment:
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      POSTGRES_DB: app
    volumes: [db:/var/lib/postgresql/data]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 2s
      retries: 30

<% elsif mysql? -%>
  db:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: app
      MYSQL_USER: app
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:?set MYSQL_PASSWORD}
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
    volumes: [db:/var/lib/mysql]
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uapp -p$$MYSQL_PASSWORD --silent"]
      interval: 3s
      retries: 40

<% end -%>
<% if redis? -%>
  redis:
    image: redis:7
    command: ["redis-server", "--save", "", "--appendonly", "no"]

<% end -%>
<% if database? -%>
  migrate:
    image: <%= app_name %>-api
    build: { context: ., target: api }
    healthcheck: { disable: true }
    command: ["bundle", "exec", "gemstack", "db:migrate"]
    environment: *api-env
<% if sqlite? -%>
    volumes: [data:/data]
<% else -%>
    depends_on: { db: { condition: service_healthy } }
<% end -%>

<% end -%>
  api:
    image: <%= app_name %>-api
    build: { context: ., target: api }
    environment:
      <<: *api-env
      WEB_CONCURRENCY: ${WEB_CONCURRENCY:-2}
<% if sqlite? -%>
    volumes: [data:/data]
<% end -%>
<% if database? -%>
    depends_on: { migrate: { condition: service_completed_successfully } }
<% end -%>
<% if jobs? -%>

  jobs:
    image: <%= app_name %>-api
    build: { context: ., target: api }
    healthcheck: { disable: true }
    command: ["bundle", "exec", "gemstack", "jobs"]
    environment: *api-env
<% if sqlite? -%>
    volumes: [data:/data]
<% end -%>
    depends_on: { migrate: { condition: service_completed_successfully } }
<% end -%>
<% if frontend? -%>

  web:
    image: <%= app_name %>-web
    build: { context: ., target: web }
    environment:
      GEMSTACK_API_URL: http://api:4000 # Server Components call the API directly
    depends_on: [api]
<% end -%>

  proxy:
    image: caddy:2
    ports: ["80:80", "443:443"]
    environment:
      SITE_ADDRESS: ${SITE_ADDRESS:-localhost}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy:/data
    depends_on: [api<%= ", web" if frontend? %>]

volumes:
<% if sqlite? -%>
  data:
<% elsif database? -%>
  db:
<% end -%>
  caddy:
