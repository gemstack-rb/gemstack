# One public origin: /api/* → Ruby, everything else → Next.js (docs/deployment.md).
# SITE_ADDRESS=example.com gets a Let's Encrypt certificate automatically;
# "localhost" uses Caddy's local CA (trust it with `caddy trust`, or curl -k).
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4000 {
			# Server-Sent Events: stream responses immediately.
			flush_interval -1
		}
	}
<% if frontend? -%>

	handle {
		reverse_proxy web:3000
	}
<% end -%>
}
